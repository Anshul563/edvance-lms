# drizzle-pg-starter environment variables

LOG_LEVEL='log_level'

NODE_ENV='node_env'

PORT='port'

CORS_ORIGIN='cors_origin'

DATABASE_URL='database_url'

# verify-auth-middleware environment variables

JWT_ACCESS_SECRET='jwt_access_secret'

JWT_REFRESH_SECRET='jwt_refresh_secret'

# rate-limiter environment variables
# Local Docker Redis (docker compose up -d redis). Inside a container this
# becomes redis://redis:6379, since localhost refers to the container itself.

REDIS_URL='redis://localhost:6379'
