# --->  Edvance recommendation service  <---
# Copy to .env and adjust. All variables are optional (sane defaults below).
# Service port
PORT=8000
# Directory for events log + trained artifacts (mounted as a volume in docker)
DATA_DIR=./data
# Retrain automatically every N newly ingested events (0 = manual /POST train only)
AUTOTRAIN_EVERY=200
# Optional Redis cache for recommendation responses (seconds, 0 = disabled)
REDIS_URL=
REC_CACHE_TTL=120
# Model hyperparameters
ALS_FACTORS=32
ALS_REG=0.1
ALS_ALPHA=40.0
ALS_ITERS=15
POP_HALF_LIFE_DAYS=30.0
W_CF=0.45
W_CONTENT=0.35
W_POP=0.20
MMR_LAMBDA=0.7
